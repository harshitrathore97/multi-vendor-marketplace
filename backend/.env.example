# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_multi_vendor_marketplace_2026
JWT_EXPIRES_IN=7d

# Database
# If left empty, an embedded in-memory MongoDB instance will automatically start for local testing & development.
DATABASE_URL=mongodb://localhost:27017/marketplace

# Caching (Optional: if empty, an in-memory TTL cache will be used)
REDIS_URL=redis://localhost:6379

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
